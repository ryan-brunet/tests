def b_spline(x):
    if(np.abs(x) < 1):
        b_spl = (4 - 6*np.abs(x)**2 + 3*np.abs(x)**3)/6
    elif(np.abs(x) < 2):
        b_spl = (2 - np.abs(x))**3 / 6
    else:
        b_spl = 0
    return b_spl

