   "source": [
    "import numpy as np\n",
    "\n",
    "A = np.zeros((4,4))\n",
    "A[0,:] = 1\n",
    "A[1,:] = 5\n",
    "A[2,:] = 3\n",
    "A[3,:] = 10\n",
    "A[:,1] = 2*A[:,1]\n",
    "A[:,2] = A[:,0] + 3*A[:,1]\n",
    "A[:,3] = 5*A[:,0]\n",
    "print(A)\n",
    "print(A.T)\n"
   ]
