   "source": [
    "import numpy as np\n",
    "from matplotlib import pyplot as plt\n",
    "\n",
    "theta = np.linspace(0, np.pi/2, 100)\n",
    "y = np.sin(theta[1:])**2 - np.sin(theta[:-1])**2\n",
    "\n",
    "fig,ax = plt.subplots()\n",
    "ax.plot(theta[:-1]*180/np.pi, y, '.')\n",
    "plt.show\n"
   ]
  },
